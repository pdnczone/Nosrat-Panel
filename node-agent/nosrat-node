#!/usr/bin/env bash
# nosrat-node — local CLI for managing the node agent on a host.
#
# Talks to the in-host local API on 127.0.0.1:9000 (started by agent.py).
# Useful for quick diagnostics without needing SSH or the panel UI.

set -Eeuo pipefail

API="http://127.0.0.1:9000"

usage() {
    cat <<EOF
nosrat-node — local node agent CLI

Usage:
    nosrat-node status                       Show local health + identity
    nosrat-node metrics                      Pretty-print the last metric sample
    nosrat-node logs [--lines N] [--follow]  Tail agent logs
    nosrat-node run <cmd> [args...]          Run a shell command via the agent
    nosrat-node self-update                  Re-download agent.py and restart
    nosrat-node help                         This help

Environment:
    NOSRAT_NODE_API  Override API endpoint (default: $API)
EOF
}

cmd="${1:-help}"
shift || true

api_get()    { curl -fsS "$API$1"; }
api_post()   { curl -fsS -X POST "$API$1" -H 'content-type: application/json' -d "${2:-{}}"; }

case "$cmd" in
    status)
        api_get /status | (command -v jq >/dev/null && jq . || cat)
        ;;
    metrics)
        api_get /metrics | (command -v jq >/dev/null && jq . || cat)
        ;;
    logs)
        api_get /health | (command -v jq >/dev/null && jq . || cat)
        ;;
    run)
        [[ $# -ge 1 ]] || { echo "usage: nosrat-node run <cmd> [args...]"; exit 2; }
        api_post /run "$(printf '%s' "$@")"
        ;;
    self-update)
        api_post /self-update
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "unknown subcommand: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac